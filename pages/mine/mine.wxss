.asset-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.asset-amount-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.asset-symbol {
  font-size: 32rpx;
  color: #E4393C;
  font-weight: 600;
  margin-right: 4rpx;
}

.asset-amount {
  font-size: 48rpx;
  font-weight: 700;
  color: #E4393C;
  line-height: 1;
  letter-spacing: 1rpx;
}
