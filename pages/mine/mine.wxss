/* pages/mine/mine.wxss */

page{
  background: #f5f5f5;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

.page-container{
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.my_top_view{
  background: #fff;
  padding: 40rpx 32rpx 32rpx;
  margin-bottom: 20rpx;
}
.login-container{
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.login-tips{
  font-size: 32rpx;
  margin-bottom: 32rpx;
  color: #333333;
  font-weight: 500;
}

.login-btn{
  background: linear-gradient(135deg, #E4393C 0%, #C81623 100%);
  color:#fff;
  padding: 28rpx 88rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(228, 57, 60, 0.3);
}

.user-info-container{
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 24rpx 0;
}
.user-main{
  display: flex;
  align-items: center;
  flex: 1;
}
.avatar-btn{
   background: transparent;
   border:none;
   padding: 0;
   margin: 0;
   line-height: 1;
   position: relative;
}

.avatar{
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: block;
}

.avatar-border {
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  right: -6rpx;
  bottom: -6rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
  opacity: 0.8;
}
.user-detail{
  margin-left: 24rpx;
  flex: 1;
}
.nickname-row{

  display: flex;
  /* align-items: center; */
  margin-bottom: 12rpx;
}
.nickname{
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  letter-spacing: 0.5rpx;
  margin-right: 16rpx;
}
.user-id{
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.user-level{
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  padding: 6rpx 6rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(255, 215, 0, 0.3);
}
.level-icon{
  margin-right: 4rpx;
  font-size: 24rpx;
}
.level-text{
  font-weight: 600;
}
.qr-code-btn{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
}

.qr-icon-box{
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFE8E8 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(228, 57, 60, 0.12);
}

.qr-text{
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #666;
  font-weight: 500;
}

.asset-card{
  margin: 0 32rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  text-align: center;
}

.asset-weapper{
  display: flex;
}

.asset-item{
  background: red;
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 40rpx 55rpx;
  position: relative;
}
